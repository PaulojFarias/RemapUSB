<Window x:Class="RemapUSB.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemapUSB" Width="1000" Height="680" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">

  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="Note" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,22,0,8" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Nav" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,9">
              <ContentPresenter HorizontalAlignment="Left" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="Tag" Value="selected">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Geometry x:Key="RemoteGeometry">M8,1 L16,1 A5,5 0 0 1 21,6 L21,22 A5,5 0 0 1 16,27 L8,27 A5,5 0 0 1 3,22 L3,6 A5,5 0 0 1 8,1 Z M12,8.5 A2.5,2.5 0 1 0 12.01,8.5 Z M9,19 L15,19 M9,22 L15,22</Geometry>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <!-- Navegação -->
    <DockPanel Margin="6,8">
      <Button x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Click="OnNavSettings">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="Configurações" />
        </StackPanel>
      </Button>
      <Button x:Name="NavDevices" DockPanel.Dock="Top" Style="{StaticResource Nav}" Click="OnNavDevices" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE772;" FontFamily="{StaticResource Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="Dispositivos" />
        </StackPanel>
      </Button>
    </DockPanel>

    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Aviso de pausa (vale para todas as telas) -->
        <Border x:Name="PausedBar" Style="{StaticResource Note}" Margin="32,20,32,0" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Retomar" Click="OnResume" />
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
              <Run FontWeight="SemiBold" Text="Remapeamento pausado." />
              <Run Text="Os botões funcionam como se o app não existisse." />
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- ============ Dispositivos ============ -->
        <ScrollViewer x:Name="DevicesView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,24,32,32">
            <TextBlock Text="Dispositivos" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

            <Border x:Name="DevicesEmpty" Style="{StaticResource Card}" Padding="24,40">
              <StackPanel HorizontalAlignment="Center">
                <Path Data="{StaticResource RemoteGeometry}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.6"
                      Width="30" Height="36" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="Nenhum dispositivo salvo" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" MaxWidth="460"
                           Text="Clique em Adicionar dispositivo e conecte o controle USB nos 30 segundos seguintes. O primeiro dispositivo conectado nesse tempo é o que fica salvo." />
                <Button Content="Adicionar dispositivo" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnAddDevice" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="DevicesList">
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Click="OnAddDevice">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Adicionar dispositivo" />
                  </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center"
                           Text="Controles salvos. Clique em um para ver e remapear os botões." />
              </DockPanel>
              <ItemsControl x:Name="DeviceItems">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonUp="OnDeviceClick" Tag="{Binding}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,16,0">
                          <Path Data="{StaticResource RemoteGeometry}" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.6"
                                Width="18" Height="22" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                          <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <CheckBox Grid.Column="3" Content="Ativo" IsChecked="{Binding Active, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"
                                  ToolTip="Ativar ou desativar os remapeamentos deste controle" />
                        <TextBlock Grid.Column="4" Text="&#xE76C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Dispositivo (botões) ============ -->
        <Grid x:Name="DeviceView" Grid.Row="1" Margin="32,24,32,20" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource Link}" Click="OnNavDevices">
              <TextBlock Text="Dispositivos" Style="{StaticResource PageTitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
            <TextBlock Text="  ›  " Style="{StaticResource PageTitle}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="DeviceTitle" Style="{StaticResource PageTitle}" />
          </StackPanel>

          <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Remover dispositivo" Margin="8,0,0,0" Click="OnRemoveDevice" />
            <Button x:Name="RecordMoreButton" DockPanel.Dock="Right" Click="OnStartRecording">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Gravar mais botões" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Margin="0,0,6,0" />
              <TextBlock x:Name="DeviceStatusText" Style="{StaticResource Caption}" />
            </StackPanel>
          </DockPanel>

          <Border x:Name="RecordingBar" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12"
                  BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Concluir gravação" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Click="OnStopRecording" />
              <Ellipse x:Name="RecordingDot" Width="12" Height="12" Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <StackPanel>
                <TextBlock Text="Gravando: aperte os botões do controle" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Cada botão novo vira uma linha. Repetir um botão só destaca a linha que já existe. Teclas de outros teclados são ignoradas." />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border x:Name="NeutralPendingBar" Grid.Row="3" Style="{StaticResource Note}" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Ir para Configurações" Click="OnNavSettings" VerticalAlignment="Center" />
              <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock x:Name="NeutralPendingText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <Border x:Name="ButtonsEmpty" Grid.Row="4" Style="{StaticResource Card}" Padding="24,40" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
              <TextBlock Text="Nenhum botão gravado ainda" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
              <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" MaxWidth="460"
                         Text="Clique em Gravar botões e aperte cada botão do controle uma vez. A lista começa vazia e vai sendo preenchida conforme os botões chegam." />
              <Button x:Name="RecordFirstButton" Content="Gravar botões" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnStartRecording" />
            </StackPanel>
          </Border>

          <Border x:Name="ButtonsList" Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="14,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.3*" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Botão" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="Parte" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="2" Text="Ação" Style="{StaticResource Caption}" />
              </Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ButtonItems">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Row" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                              Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnButtonRowClick" Tag="{Binding}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,12,0">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                     Background="Transparent" BorderThickness="0" Padding="2,1" MinHeight="0"
                                     LostFocus="OnButtonNameLostFocus" ToolTip="Clique para renomear" />
                            <TextBlock Text="{Binding CodeText}" Style="{StaticResource Caption}" FontFamily="Consolas" FontSize="11" Margin="2,3,0,0" />
                          </StackPanel>
                          <Border Grid.Column="1" CornerRadius="10" Padding="8,1" Background="{Binding PartBackground}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PartLabel}" FontSize="11" FontWeight="SemiBold" />
                          </Border>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActionMain}" Foreground="{Binding ActionBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActionSub}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Flash}" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <TextBlock x:Name="ButtonsHint" Grid.Row="5" Style="{StaticResource Caption}" Margin="0,10,0,0"
                     Text="Clique numa linha para escolher a ação. O nome do botão pode ser editado direto na lista." />
        </Grid>

        <!-- ============ Configurações ============ -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="32,24,32,32">
            <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,4">
              <DockPanel>
                <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnStartupClick" />
                <StackPanel>
                  <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Caption}" Text="O app abre na bandeja quando você entra no Windows." />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <CheckBox x:Name="LogCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnLogClick" />
                <Button DockPanel.Dock="Right" Content="Abrir pasta" Margin="0,0,12,0" VerticalAlignment="Center" Click="OnOpenLogFolder" />
                <StackPanel>
                  <TextBlock Text="Registrar log em arquivo" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Caption}"
                             Text="Conexão e desconexão do controle, botões recebidos e ações disparadas. Teclas de outros teclados não entram." />
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock Text="Teclas neutralizadas no Windows" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
                  <Button x:Name="ApplyNeutralButton" Content="Aplicar (administrador)" Style="{DynamicResource AccentButtonStyle}"
                          HorizontalAlignment="Stretch" Click="OnApplyNeutral" />
                  <Button x:Name="UndoNeutralButton" Content="Desfazer tudo" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="OnUndoNeutral" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="NeutralTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                             Text="Botões da parte de teclado marcados como Neutralizar precisam desta configuração do Windows. Ela vale para todos os teclados e só entra em vigor depois de reiniciar." />
                  <Border x:Name="NeutralWarn" Style="{StaticResource Note}" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NeutralWarnText" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </DockPanel>
            </Border>

            <TextBlock Text="Sobre" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RemapUSB" FontWeight="SemiBold" />
                <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============ Editor de ação (painel lateral) ============ -->
    <Grid x:Name="EditorOverlay" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Border Background="#55000000" MouseLeftButtonDown="OnEditorScrimClick" />
      <Border HorizontalAlignment="Right" Width="440" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Padding="22,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
              <Button DockPanel.Dock="Left" Content="Remover botão" Click="OnRemoveButton" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Margin="0,0,8,0" Click="OnEditorCancel" />
                <Button Content="Salvar" Style="{DynamicResource AccentButtonStyle}" Click="OnEditorSave" />
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel DockPanel.Dock="Top" Margin="22,18,22,4">
            <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Border x:Name="EditorBadge" CornerRadius="10" Padding="8,1" Margin="0,0,8,0">
                <TextBlock x:Name="EditorBadgeText" FontSize="11" FontWeight="SemiBold" />
              </Border>
              <TextBlock x:Name="EditorCode" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,0,22,16">
              <TextBlock Text="Ação" Style="{StaticResource Label}" />
              <ComboBox x:Name="ActionCombo" HorizontalAlignment="Stretch" SelectionChanged="OnActionChanged" />

              <StackPanel x:Name="AppPanel" Visibility="Collapsed">
                <TextBlock Text="App" Style="{StaticResource Label}" />
                <TextBox x:Name="AppSearch" TextChanged="OnAppSearchChanged" ToolTip="Procurar app instalado" />
                <TextBlock x:Name="AppLoading" Text="Carregando apps instalados…" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <ListBox x:Name="AppList" Height="200" Margin="0,6,0,0" SelectionChanged="OnAppSelected" HorizontalContentAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel ToolTip="{Binding Detail}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource Caption}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,6,0,0">
                  <Button DockPanel.Dock="Right" Content="Procurar .exe…" Click="OnBrowseExe" />
                  <TextBlock x:Name="AppSelected" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="AppHint" Style="{StaticResource Caption}" Margin="0,8,0,0" />
              </StackPanel>

              <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                <TextBlock Text="Tecla ou atalho" Style="{StaticResource Label}" />
                <DockPanel>
                  <Button x:Name="CaptureButton" DockPanel.Dock="Right" Content="Capturar" Click="OnCaptureClick" />
                  <TextBlock x:Name="KeysText" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="Clique em Capturar e pressione a tecla ou o atalho no teclado do PC (ex.: Ctrl + Shift + T)." />
              </StackPanel>

              <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                <TextBlock Text="Tecla de mídia" Style="{StaticResource Label}" />
                <ComboBox x:Name="MediaCombo" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel x:Name="SitePanel" Visibility="Collapsed">
                <TextBlock Text="Endereço" Style="{StaticResource Label}" />
                <TextBox x:Name="UrlBox" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Abre no navegador padrão. Ex.: https://www.youtube.com" />
              </StackPanel>

              <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                <TextBlock Text="Arquivo ou pasta" Style="{StaticResource Label}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Procurar…" Margin="6,0,0,0" Click="OnBrowseFile" />
                  <TextBox x:Name="PathBox" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Abre com o programa padrão do Windows para esse tipo de arquivo." />
              </StackPanel>

              <StackPanel x:Name="CmdPanel" Visibility="Collapsed">
                <TextBlock Text="Comando" Style="{StaticResource Label}" />
                <TextBox x:Name="CmdBox" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Roda sem abrir janela, com as permissões do seu usuário." />
              </StackPanel>

              <TextBlock x:Name="SimpleHint" Style="{StaticResource Caption}" Margin="0,12,0,0" />

              <StackPanel x:Name="OriginalPanel" Visibility="Collapsed">
                <TextBlock Text="Tecla original" Style="{StaticResource Section}" />
                <TextBlock x:Name="OriginalIntro" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                  <RadioButton x:Name="PassRadio" GroupName="Original" Checked="OnOriginalChanged">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold"><Run Text="Deixar passar" /><Run Text=" (padrão)" FontWeight="Normal" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /></TextBlock>
                      <TextBlock x:Name="PassText" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </RadioButton>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10">
                  <RadioButton x:Name="NeutralRadio" GroupName="Original" Checked="OnOriginalChanged">
                    <StackPanel>
                      <TextBlock Text="Neutralizar" FontWeight="SemiBold" />
                      <TextBlock x:Name="NeutralText" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </RadioButton>
                </Border>
                <Border x:Name="OriginalWarn" Style="{StaticResource Note}" Margin="0,8,0,0">
                  <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0" />
                    <TextBlock x:Name="OriginalWarnText" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="MediaOriginalPanel" Visibility="Collapsed">
                <TextBlock Text="Tecla original" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Note}">
                  <DockPanel>
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="MediaOriginalText" TextWrapping="Wrap" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ Escuta (adicionar dispositivo) ============ -->
    <Grid x:Name="ListenOverlay" Grid.ColumnSpan="2" Background="#55000000" Visibility="Collapsed">
      <Border Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Padding="24,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ListenCancel" Content="Cancelar" Click="OnListenCancel" />
              <Button x:Name="ListenRetry" Content="Tentar de novo" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Click="OnAddDevice" />
              <Button x:Name="ListenSave" Content="Salvar e gravar botões" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Click="OnListenSave" />
            </StackPanel>
          </Border>
          <StackPanel Margin="24,22">
            <TextBlock x:Name="ListenTitle" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ListenText" Style="{StaticResource Caption}" FontSize="14" Margin="0,6,0,0" />

            <StackPanel x:Name="ListenCountdown" Margin="0,18,0,4">
              <TextBlock x:Name="ListenSeconds" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="segundos" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
              <ProgressBar x:Name="ListenProgress" Maximum="30" Height="4" Margin="0,14,0,0" />
            </StackPanel>

            <StackPanel x:Name="ListenFound">
              <TextBlock Text="Nome" Style="{StaticResource Label}" />
              <TextBox x:Name="ListenName" />
              <TextBlock Text="Partes encontradas" Style="{StaticResource Label}" />
              <ItemsControl x:Name="ListenParts">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,4">
                      <TextBlock Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                         Text="Teclado e mídia podem ser remapeados. O botão Power e o ponteiro do mouse não são suportados nesta versão." />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
