<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish for the installer: Release, Windows 64-bit, no .NET install needed, as a single
  RemapUSB.exe. Goes to installer\publish, where installer\RemapUSB.iss reads it from.
  Command line: dotnet publish src/RemapUSB.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\installer\publish\</PublishDir>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF has native DLLs; without this they end up loose next to the .exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The whole .NET runtime goes inside the .exe; compressed, it drops to less than half. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No .pdb (debug symbols) in what gets installed. -->
    <DebugType>none</DebugType>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
